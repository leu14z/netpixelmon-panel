# ==========================================
# VARIÁVEIS DE AMBIENTE - VERCEL & SUPABASE
# ==========================================

# 1. Conexão com o Supabase (PostgreSQL)
# Copie do painel do Supabase: Project Settings -> Database -> Connection Strings
# Use a Connection String em modo "Transaction" (porta 6543) com pgbouncer=true:
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use a Connection String em modo "Session" ou direto (porta 5432) para migrations:
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Segurança & Criptografia
# Gere chaves seguras com 32 caracteres aleatórios:
JWT_SECRET="netpixelmon_super_secret_jwt_key_2026_production"
AES_ENCRYPTION_KEY="netpixelmon_aes_32_bytes_key_prod!"

# 3. Cloudflare Turnstile (Anti-Bot na tela de Login)
# Se não for usar Cloudflare Turnstile real agora, deixe o valor padrão de teste:
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# 4. Integração Discord Webhooks (Opcional)
# Canal privado de avisos da staff no seu servidor Discord:
DISCORD_WEBHOOK_URL=""
